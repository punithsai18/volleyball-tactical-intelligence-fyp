{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/app/static/$1"
    },
    {
      "source": "/style.css",
      "destination": "/app/static/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/app/static/app.js"
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/app/static/gallery/$1"
    },
    {
      "source": "/",
      "destination": "/app/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app/static/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
